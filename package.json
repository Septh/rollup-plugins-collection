{
  "name": "@septh/rollup-plugins-collection",
  "version": "1.2.1",
  "description": "A collection of tiny useful plugins for your everyday Rollup.",
  "keywords": [
    "rollup",
    "plugin",
    "multi"
  ],
  "author": "Stephan 'Septh' Schreiber <septh@sfr.fr>",
  "homepage": "https://github.com/septh/plugins-collection",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/septh/plugins-collection"
  },
  "bugs": "https://github.com/septh/plugins-collection/issues",
  "license": "MIT",
  "funding": [
    {
      "type": "patreon",
      "url": "https://patreon.com/Septh"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/septh07"
    }
  ],
  "engines": {
    "node": ">= 22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    },
    "./no-comment": {
      "types": "./dist/no-comment.d.ts",
      "default": "./dist/no-comment.js"
    },
    "./production": {
      "types": "./dist/production.d.ts",
      "default": "./dist/production.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!*.map"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "npm run buildOnly",
    "buildOnly": "npm run build:js && npm run build:dts",
    "build:js": "tsc -p tsconfig.build.json --declaration false --declarationMap false --removeComments",
    "build:dts": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "test": "echo \"No test yet\""
  },
  "dependencies": {
    "magic-string": "^0.30.21",
    "regex": "^6.1.0",
    "zimmerframe": "^1.1.4"
  },
  "peerDependencies": {
    "rollup": "^4.50.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/node": "^24.12.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.1",
    "typescript": "^6.0.2"
  }
}
