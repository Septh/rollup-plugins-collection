{
  "extends": "./tsconfig.json",
  "include": [ "source" ],
  "compilerOptions": {

    // Input
    "rootDir": "source",

    // Output
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "preserveConstEnums": false,
    "allowJs": false,
    "checkJs": false,
    "noEmit": false
  }
}
